# Trade4u - Simple Static Server + Python Agents
# Node serves React static, Python runs trading agents

# ============ Stage 1: Build React Client ============
FROM node:20-slim as react-build

WORKDIR /client
COPY client/package*.json ./
RUN npm install
COPY client/ ./
RUN npm run build

# ============ Stage 2: Python Dependencies ============
FROM python:3.13-slim as python-deps

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# ============ Stage 3: Final Image ============
FROM python:3.13-slim

# Install Node.js for server
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Python deps
COPY --from=python-deps /app /app

# Copy root level files
COPY main.py ./
COPY pyproject.toml ./
COPY tradingagents/ ./tradingagents/

# Copy server with dependencies
COPY server/ ./server/
RUN cd server && npm install --production

# Copy built React files
COPY --from=react-build /client/dist ./public

ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTHONUNBUFFERED=1
ENV NODE_ENV=production
ENV PORT=8501

EXPOSE 8501

# Start Node.js server (serves React static + proxies to Python)
CMD ["node", "server/src/index.js"]