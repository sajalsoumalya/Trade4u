# Trade4u - Full Stack (Node.js + React) Dockerfile
# Build React first, then serve with Node.js

FROM python:3.13-slim as builder

# ============ Install Node.js for building React ============
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /client

# ============ Build React Client ============
COPY client/package*.json ./
RUN npm install
COPY client/ ./
RUN npm run build

# ============ Python Dependencies ============
FROM python:3.13-slim

WORKDIR /app

# Install Python deps
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Install local package
COPY main.py ./
COPY tradingagents/ ./tradingagents/
COPY tradingagents_web/ ./tradingagents_web/
RUN pip install --no-cache-dir -e .

# Copy built React files to be served
COPY --from=builder /client/dist ./public

ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTHONUNBUFFERED=1

EXPOSE 8501

CMD ["python", "-c", "print('Use Streamlit: streamlit run tradingagents_web/app.py --server.port 8501')"]