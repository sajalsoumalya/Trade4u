# Trade4u - Full Stack (Node.js + React) Dockerfile
# Multi-stage build: Build React, then serve with Node.js

# ============ Stage 1: Build React Client ============
FROM node:20-slim as react-build

WORKDIR /client
COPY client/package*.json ./
RUN npm install
COPY client/ ./
RUN npm run build

# ============ Stage 2: Python Dependencies ============
FROM python:3.13-slim as python-deps

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# ============ Stage 3: Final Image ============
FROM python:3.13-slim

# Install Node.js for server
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Python deps
COPY --from=python-deps /app /app

# Copy source
COPY main.py ./
COPY tradingagents/ ./tradingagents/
COPY tradingagents_web/ ./tradingagents_web/
COPY server/ ./server/

# Copy built React files
COPY --from=react-build /client/dist ./public

# Install package
RUN pip install --no-cache-dir -e .

ENV PYTHONPATH="/app:$PYTHONPATH"
ENV PYTHONUNBUFFERED=1
ENV NODE_ENV=production
ENV PORT=8501

EXPOSE 8501

# Start Node.js server (serves React) + Python available for API calls
CMD ["node", "server/src/index.js"]