FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install all dependencies in one layer
RUN pip install --no-cache-dir \
    "langchain-core>=0.3.81" \
    "langchain-anthropic>=0.3.15" \
    "langchain-openai>=0.3.23" \
    "langgraph>=0.4.8" \
    "langgraph-checkpoint-sqlite>=2.0.0" \
    "yfinance>=0.2.63" \
    "pandas>=2.3.0" \
    "streamlit>=1.28.0" \
    "rich>=14.0.0" \
    "typer>=0.21.0" \
    "questionary>=2.1.0" \
    "requests>=2.32.4" \
    "pytz>=2025.2" \
    "backtrader>=1.9.78.123" \
    "stockstats>=0.6.5" \
    "parsel>=1.10.0" \
    "python-dotenv>=0.21.0" \
    "pydantic-settings>=2.10.1" \
    "setuptools>=80.9.0" \
    "numpy>=2.1.0" \
    "pytest"

# Copy source
COPY tradingagents/ /app/tradingagents/
COPY tradingagents_web/ /app/tradingagents_web/
COPY main.py /app/main.py
COPY README.md /app/README.md

# Streamlit config
RUN mkdir -p /root/.streamlit && \
    echo '[server]' > /root/.streamlit/config.toml && \
    echo 'port = 8501' >> /root/.streamlit/config.toml && \
    echo 'headless = true' >> /root/.streamlit/config.toml && \
    echo 'enableCORS = false' >> /root/.streamlit/config.toml && \
    echo 'enableXsrfProtection = true' >> /root/.streamlit/config.toml

EXPOSE 8501

CMD ["streamlit", "run", "tradingagents_web/app.py", "--server.port=8501", "--server.address=0.0.0.0"]