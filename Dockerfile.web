FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /home/appuser/app

# Install dependencies first
RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    langchain-core langchain-anthropic langchain-openai langgraph \
    yfinance pandas streamlit rich typer question tqdm requests pytz \
    langgraph-checkpoint-sqlite backtrader stockstats parsel \
    python-dotenv pydantic-settings setuptools frozendict \
    multidict frozenlist aiosignal yarl propcache attrs aiohappyeyeballs \
    aiohttp dataclasses-json marshmallow typing-inspect typing-inspect \
    pydantic pydantic-core typing-extensions annotated-types \
    distro docstring-parser jiter sniffio anyio \
    idna certifi httpcore h11 httpx \
    openai tiktoken regex \
    google-genai google-auth websockets cryptography cffi pyasn1 pyasn1-modules \
    langchain-experimental langchain-community langchain-classic \
    langchain-google-genai SQLAlchemy \
    beautifulsoup4 frozendict peewee multitasking platformdirs \
    beautifulsoup4 curl_cffi protobuf pyarrow pillow \
    blinker cachetools gitpython pydeck toml starlette uvicorn \
    httptools python-multipart itsdangerous watchdog \
    altair jsonschema narwhals markdown-it-py mdurl pygments \
    rich prompt_toolkit wcwidth soupsieve jsonpointer jsonschema-specifications \
    referencing rpds-py smmap gitdb lxml cssselect jmespath w3lib \
    greenlet narwhals orjson ormsgpack xxhash zstandard \
    packaging python-multipart python-dateutil six \
    numpy pandas pyyaml jsonpatch langchain-protocol langsmith uuid-utils \
    tenacity uuid-utils urllib3 charset_normalizer certifi \
    toml tqdm shellingham annotated-doc

# Copy source code
COPY tradingagents/ ./tradingagents/
COPY tradingagents_web/ ./tradingagents_web/
COPY main.py .
COPY README.md .

# Streamlit config
RUN mkdir -p /home/appuser/.streamlit && \
    echo '[server]' > /home/appuser/.streamlit/config.toml && \
    echo 'port = 8501' >> /home/appuser/.streamlit/config.toml && \
    echo 'headless = true' >> /home/appuser/.streamlit/config.toml && \
    echo 'enableCORS = false' >> /home/appuser/.streamlit/config.toml && \
    echo 'enableXsrfProtection = true' >> /home/appuser/.streamlit/config.toml && \
    echo '' >> /home/appuser/.streamlit/config.toml && \
    echo '[browser]' >> /home/appuser/.streamlit/config.toml && \
    echo 'serverAddress = "0.0.0.0"' >> /home/appuser/.streamlit/config.toml && \
    echo 'gatherUsageStats = false' >> /home/appuser/.streamlit/config.toml

EXPOSE 8501

CMD ["streamlit", "run", "tradingagents_web/app.py", "--server.port=8501", "--server.address=0.0.0.0"]